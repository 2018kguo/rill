{
  "name": "rill",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node conformance/diff.mjs",
    "tables": "node crates/rill-cmark/gen-unicode-tables.mjs",
    "wasm": "sh scripts/build-wasm.sh",
    "demo": "npm run demo:build && bun demo/serve.js",
    "demo:build": "sh scripts/build-wasm.sh && bun build demo/main.js --outdir demo/dist --target browser && mkdir -p demo/dist/katex && cp js/wasm/rill_bg.wasm demo/dist/ && cp -R node_modules/katex/dist/katex.min.css node_modules/katex/dist/fonts demo/dist/katex/"
  },
  "dependencies": {
    "@streamdown/cjk": "1.0.4",
    "@streamdown/math": "1.0.3",
    "get-east-asian-width": "1.5.0",
    "hast-util-to-html": "9.0.5",
    "katex": "0.16.47",
    "micromark-extension-cjk-friendly-util": "3.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "streamdown": "2.7.1",
    "unified": "11.0.5"
  },
  "workspaces": [
    "js"
  ],
  "devDependencies": {
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/cli": "^4.1.14",
    "binaryen": "132.0.0",
    "playwright": "^1.64.1",
    "remark-cjk-friendly-1": "npm:remark-cjk-friendly@1.2.3",
    "remark-cjk-friendly-gfm-strikethrough-1": "npm:remark-cjk-friendly-gfm-strikethrough@1.2.3",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.14"
  }
}
