{
  "name": "@2018kguo/rill",
  "version": "0.2.0",
  "description": "A drop-in for Streamdown's <Streamdown>: the same DOM with a fraction of the main-thread work, rendered in Rust compiled to WebAssembly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2018kguo/rill.git",
    "directory": "js"
  },
  "keywords": [
    "ai",
    "chat",
    "markdown",
    "rehype",
    "remark",
    "shiki",
    "streamdown",
    "syntax-highlighting",
    "webassembly"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./streamdown": {
      "types": "./dist/streamdown.d.ts",
      "default": "./dist/streamdown.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./wasm/rill_bg.wasm": "./wasm/rill_bg.wasm"
  },
  "files": [
    "dist",
    "wasm",
    "src"
  ],
  "scripts": {
    "build": "sh ../scripts/build-wasm.sh && tsc -p .",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@2018kguo/rill-highlight": "^0.1.0",
    "clsx": "^2.1.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "marked": "^18.0.11",
    "property-information": "^7.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "style-to-js": "^1.1.0",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "streamdown": "^2.7.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "typescript": "5.9.3"
  }
}
